  "Variant": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "operation_id": {
        "type": "string",
        "format": "uuid"
      },
      "source_id": {
        "type": "string",
        "format": "uuid"
      },
      "deployment_id": {
        "type": "string",
        "format": "uuid"
      },
      "policy_revision": {
        "type": "integer",
        "minimum": 1
      },
      "fingerprint": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "structure": {
        "$ref": "../batch.schema.json#/$defs/node"
      },
      "count": {
        "type": "integer",
        "minimum": 0
      },
      "first_seen": {
        "type": "string",
        "format": "date-time"
      },
      "last_seen": {
        "type": "string",
        "format": "date-time"
      },
      "visibility": {
        "type": "string",
        "enum": [
          "structure",
          "operation",
          "connection"
        ]
      },
      "completeness": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "unavailable"
        ]
      },
      "direction": {
        "type": "string",
        "enum": [
          "request",
          "response",
          "publish",
          "consume",
          "operation",
          "connection"
        ]
      },
      "sample_numerator": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "sample_denominator": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "reasons": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 8,
        "items": {
          "type": "string",
          "enum": [
            "permission",
            "encrypted",
            "unsupported",
            "sampled",
            "limit",
            "malformed",
            "source_gap",
            "clock_skew"
          ]
        }
      },
      "route_uncertain": {
        "type": "boolean"
      },
      "health_reported_at": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "collector_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "id",
      "operation_id",
      "source_id",
      "deployment_id",
      "policy_revision",
      "fingerprint",
      "structure",
      "count",
      "first_seen",
      "last_seen",
      "visibility",
      "completeness",
      "direction",
      "sample_numerator",
      "sample_denominator",
