    "/v1/observations": {
      "get": {
        "operationId": "listObservationHistory",
        "description": "List immutable stored observations for the authorized operation in the server-configured tenant, project, service and environment. Results are ordered by observation UUID. The cursor must identify an observation in the same scope. A page can contain fewer than the requested limit when the bounded response size is reached; use next_cursor to continue. Historical origin evidence is unavailable and must not be inferred from current catalog origins.",
        "security": [{"userOidc": []}],
        "parameters": [
          {"name":"operation_id","in":"query","required":true,"schema":{"$ref":"#/components/schemas/HistoryUuid"}},
          {"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50,"default":50}},
          {"name":"cursor","in":"query","description":"Last observation UUID from the preceding page, within this exact operation and scope.","schema":{"$ref":"#/components/schemas/HistoryUuid"}}
        ],
        "responses": {
          "200":{"description":"Authorized page, bounded to at most 50 observations and 1 MiB.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObservationHistoryPage"}}}},
          "400":{"description":"Invalid query, limit, or cursor outside the selected scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "401":{"description":"Authentication required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "403":{"description":"The authenticated principal is not authorized for the configured scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "404":{"description":"Operation unavailable in the configured scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "503":{"description":"Evidence, authorization or database unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "default":{"description":"Safe error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/observations/{id}": {
      "get": {
        "operationId": "getObservationHistory",
        "description": "Read one immutable stored observation for the authorized operation and configured environment. Historical origin evidence is unavailable; current catalog origins do not establish this observation's historical origin.",
        "security": [{"userOidc": []}],
        "parameters": [
          {"name":"id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/HistoryUuid"}},
          {"name":"operation_id","in":"query","required":true,"schema":{"$ref":"#/components/schemas/HistoryUuid"}}
        ],
        "responses": {
          "200":{"description":"Authorized immutable observation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObservationHistory"}}}},
          "400":{"description":"Invalid operation or observation identifier, or query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "401":{"description":"Authentication required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "403":{"description":"The authenticated principal is not authorized for the configured scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "404":{"description":"Observation or operation unavailable in the configured scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "503":{"description":"Evidence, authorization or database unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
          "default":{"description":"Safe error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/observations/{id}/origin": {"get":{"operationId":"getObservationHistoricalOrigin","description":"Read exact stored observation origin after target and origin scope authorization. Unavailable evidence and denied origin scope disclose no identifiers.","security":[{"userOidc":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/HistoryUuid"}},{"name":"operation_id","in":"query","required":true,"schema":{"$ref":"#/components/schemas/HistoryUuid"}}],"responses":{"200":{"description":"Verified historical origin or unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HistoricalObservationOrigin"}}}},"400":{"description":"Invalid identifier or query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Target scope forbidden.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Observation or operation unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Evidence or database unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
    "/v1/contracts/import": {
      "$ref": "./paths/catalog.json#/~1v1~1contracts~1import"
    },
