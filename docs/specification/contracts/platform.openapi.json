  "components": {
    "securitySchemes": {
      "collectorMtls": {
        "type": "mutualTLS"
      },
      "bootstrapToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived single-use enrollment token, consumed atomically."
      },
      "userOidc": {
        "type": "http",
        "scheme": "bearer",
        "description": "OIDC access token; issuer/audience and scoped authorization are validated."
      },
      "ciToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived scoped service token; sanitized import and comparison only, no approval or policy writes."
      }
    },
    "schemas": {
      "HistoryUuid": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
      "ObservationHistoryPage": {
        "type":"object","additionalProperties":false,"required":["items","next_cursor"],
        "properties":{
          "items":{"type":"array","maxItems":50,"items":{"$ref":"#/components/schemas/ObservationHistory"}},
          "next_cursor":{"description":"Last returned observation UUID when more results remain, otherwise null.","anyOf":[{"$ref":"#/components/schemas/HistoryUuid"},{"type":"null"}]}
        }
      },
      "HistoricalObservationOrigin": {"oneOf":[{"type":"object","additionalProperties":false,"required":["observation_id","operation_id","status","origin"],"properties":{"observation_id":{"$ref":"#/components/schemas/HistoryUuid"},"operation_id":{"$ref":"#/components/schemas/HistoryUuid"},"status":{"const":"verified"},"origin":{"type":"object","additionalProperties":false,"required":["project_id","service_id","environment_id","deployment_id","instance_id","lifecycle_id","credential_id","grant_id"],"properties":{"project_id":{"$ref":"#/components/schemas/HistoryUuid"},"service_id":{"$ref":"#/components/schemas/HistoryUuid"},"environment_id":{"$ref":"#/components/schemas/HistoryUuid"},"deployment_id":{"$ref":"#/components/schemas/HistoryUuid"},"instance_id":{"$ref":"#/components/schemas/HistoryUuid"},"lifecycle_id":{"$ref":"#/components/schemas/HistoryUuid"},"credential_id":{"$ref":"#/components/schemas/HistoryUuid"},"grant_id":{"$ref":"#/components/schemas/HistoryUuid"}}}}},{"type":"object","additionalProperties":false,"required":["observation_id","operation_id","status","origin"],"properties":{"observation_id":{"$ref":"#/components/schemas/HistoryUuid"},"operation_id":{"$ref":"#/components/schemas/HistoryUuid"},"status":{"const":"unavailable"},"origin":{"type":"null"}}}]},
      "ObservationHistory": {
        "type":"object","additionalProperties":false,
        "required":["id","operation_id","structure","visibility","completeness","reasons","route_uncertain","first_seen","last_seen","queued_at","expires_at","sample_numerator","sample_denominator","count","parser_profile","status_code","structure_fingerprint","policy_revision","protocol","direction","operation","route_template","canonicalization_version","origin_evidence"],
        "properties":{
          "id":{"$ref":"#/components/schemas/HistoryUuid"},
          "operation_id":{"$ref":"#/components/schemas/HistoryUuid"},
          "structure":{"description":"Sanitized structure only, at most 65536 serialized bytes and depth 32. Unknown nodes and their reasons are evidence, not absent fields.","$ref":"./batch.schema.json#/$defs/node"},
          "structure_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"SHA-256 fingerprint of the versioned canonical structure."},
          "canonicalization_version":{"const":1},
          "origin_evidence":{"const":"unavailable","description":"No historical origin proof is returned for this observation."},
          "policy_revision":{"type":"string","pattern":"^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$","description":"Positive u64 revision represented as a decimal string."},
          "protocol":{"type":"string","enum":["http","graphql","grpc","websocket","kafka","mqtt","cloud"]},
          "direction":{"type":"string","enum":["request","response","publish","consume","operation","connection"]},
          "operation":{"type":"string","minLength":1,"maxLength":32},
          "route_template":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^?#]+$"},
          "visibility":{"type":"string","enum":["structure","operation","connection"]},
          "completeness":{"type":"string","enum":["complete","partial","unavailable"]},
          "reasons":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","enum":["permission","encrypted","unsupported","sampled","limit","malformed","source_gap","clock_skew"]}},
          "route_uncertain":{"type":"boolean"},
          "first_seen":{"$ref":"./batch.schema.json#/$defs/timestamp"},
          "last_seen":{"$ref":"./batch.schema.json#/$defs/timestamp"},
          "queued_at":{"$ref":"./batch.schema.json#/$defs/timestamp"},
          "expires_at":{"$ref":"./batch.schema.json#/$defs/timestamp"},
          "sample_numerator":{"type":"integer","minimum":1,"maximum":1000000,"description":"Must not exceed sample_denominator."},
          "sample_denominator":{"type":"integer","minimum":1,"maximum":1000000},
          "count":{"type":"integer","minimum":1,"maximum":1000000000},
          "parser_profile":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z_][A-Za-z0-9_.-]*$"},
          "status_code":{"anyOf":[{"type":"integer","minimum":100,"maximum":599},{"type":"null"}]}
        }
      },
      "Error": {
        "$ref": "./schemas/collector.json#/Error"
      },
      "Receipt": {
        "$ref": "./schemas/collector.json#/Receipt"
      },
      "EnrollmentRequest": {
        "$ref": "./schemas/collector.json#/EnrollmentRequest"
      },
      "EnrollmentResult": {
        "$ref": "./schemas/collector.json#/EnrollmentResult"
      },
      "Policy": {
        "$ref": "./schemas/collector.json#/Policy"
      },
      "SignedPolicy": {
        "$ref": "./schemas/collector.json#/SignedPolicy"
      },
      "Health": {
        "$ref": "./schemas/collector.json#/Health"
      },
      "SourceRequest": {
        "$ref": "./schemas/collector.json#/SourceRequest"
      },
      "Source": {
        "$ref": "./schemas/collector.json#/Source"
      },
      "Operation": {
        "$ref": "./schemas/catalog.json#/Operation"
      },
      "Variant": {
        "$ref": "./schemas/catalog.json#/Variant"
      },
      "ImportRequest": {
        "$ref": "./schemas/catalog.json#/ImportRequest"
      },
      "Contract": {
        "$ref": "./schemas/catalog.json#/Contract"
      },
      "ComparisonRequest": {
        "$ref": "./schemas/review.json#/ComparisonRequest"
      },
      "Difference": {
        "$ref": "./schemas/review.json#/Difference"
      },
      "Comparison": {
        "$ref": "./schemas/review.json#/Comparison"
      },
      "ReviewRequest": {
        "$ref": "./schemas/review.json#/ReviewRequest"
      },
      "Review": {
        "$ref": "./schemas/review.json#/Review"
      },
      "Decision": {
        "$ref": "./schemas/review.json#/Decision"
      },
      "AuditEvent": {
        "$ref": "./schemas/review.json#/AuditEvent"
      },
      "CiRequest": {
        "$ref": "./schemas/review.json#/CiRequest"
      },
      "CiResult": {
        "$ref": "./schemas/review.json#/CiResult"
      },
      "Export": {
        "$ref": "./schemas/catalog.json#/Export"
      },
      "OperationList": {
        "$ref": "./schemas/catalog.json#/OperationList"
      },
      "VariantList": {
        "$ref": "./schemas/catalog.json#/VariantList"
      },
      "AuditEventList": {
        "$ref": "./schemas/review.json#/AuditEventList"
      },
      "ReviewList": {
        "$ref": "./schemas/review.json#/ReviewList"
      },
      "HealthList": {
        "$ref": "./schemas/collector.json#/HealthList"
      },
      "Revocation": {
        "$ref": "./schemas/collector.json#/Revocation"
      },
      "RevocationResult": {
        "$ref": "./schemas/collector.json#/RevocationResult"
      }
    }
  }
