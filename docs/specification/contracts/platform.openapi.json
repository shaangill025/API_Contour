      "collectorMtls": {
        "type": "mutualTLS"
      },
      "bootstrapToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived single-use enrollment token, consumed atomically."
      },
      "userOidc": {
        "type": "http",
        "scheme": "bearer",
        "description": "OIDC access token; issuer/audience and scoped authorization are validated."
      },
      "ciToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived scoped service token; sanitized import and comparison only, no approval or policy writes."
      }
