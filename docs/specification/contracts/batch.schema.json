{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apicontour.invalid/spec/v1/batch.schema.json",
  "title": "APIContour sanitized batch v1",
  "type": "object",
  "properties": {
    "wire_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "collector_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "wire_version",
    "batch_id",
    "tenant_id",
    "collector_id",
    "created_at",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35,
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "null",
                "boolean",
                "integer",
                "number",
                "string",
                "binary"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "enum": [
                "empty",
                "unsupported",
                "limit",
                "malformed",
                "encrypted"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "object"
            },
            "fields": {
              "type": "object",
              "maxProperties": 256,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            },
            "additional": {
              "anyOf": [
                {
                  "$ref": "#/$defs/node"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "fields",
            "additional"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "union"
            },
            "alternatives": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "kind",
            "alternatives"
          ],
          "additionalProperties": false
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "service_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "http",
            "graphql",
            "grpc",
            "websocket",
            "kafka",
            "mqtt",
            "cloud"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "request",
            "response",
            "publish",
            "consume",
            "operation",
            "connection"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "route_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "route_uncertain": {
          "type": "boolean"
        },
        "parser_profile": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "visibility": {
          "type": "string",
          "enum": [
            "structure",
            "operation",
            "connection"
          ]
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "permission",
              "encrypted",
              "unsupported",
              "sampled",
              "limit",
              "malformed",
              "source_gap",
              "clock_skew"
            ]
          }
        },
        "structure": {
          "$ref": "#/$defs/node"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "first_seen": {
          "$ref": "#/$defs/timestamp"
        },
        "last_seen": {
          "$ref": "#/$defs/timestamp"
        },
        "sample_numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sample_denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "status_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_header_names": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "response_header_names": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "query_parameter_names": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "queued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "record_id",
        "project_id",
        "service_id",
        "environment_id",
        "deployment_id",
        "protocol",
        "direction",
        "operation",
        "route_template",
        "route_uncertain",
        "parser_profile",
        "policy_revision",
        "visibility",
        "completeness",
        "reasons",
        "structure",
        "count",
        "first_seen",
        "last_seen",
        "sample_numerator",
        "sample_denominator",
        "status_code",
        "source_id",
        "request_header_names",
        "response_header_names",
        "query_parameter_names",
        "queued_at",
        "expires_at"
      ],
      "additionalProperties": false
    }
  }
}
