{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apicontour.invalid/spec/v1/causal-grant.schema.json",
  "type": "object",
  "properties": {
    "grant_version": {
      "type": "integer",
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "collector_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lifecycle_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "instance_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "causal_profile": {
      "const": "nodered_5_0_9_v1"
    },
    "profile_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$(?!\\n)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$(?!\\n)"
    },
    "enabled": {
      "type": "boolean"
    },
    "event_kinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "root",
          "delivery",
          "attempt",
          "loss"
        ]
      }
    },
    "max_batch_events": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "max_batch_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "queue_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "queue_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  },
  "required": [
    "grant_version",
    "tenant_id",
    "collector_id",
    "runtime_id",
    "source_id",
    "lifecycle_id",
    "instance_id",
    "causal_profile",
    "profile_sha256",
    "revision",
    "issued_at",
    "expires_at",
    "enabled",
    "event_kinds",
    "max_batch_events",
    "max_batch_bytes",
    "queue_bytes",
    "queue_ttl_seconds"
  ],
  "additionalProperties": false
}
