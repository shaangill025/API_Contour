[
  {
    "id": "pilot-tab",
    "type": "tab",
    "label": "Owned synthetic pilot",
    "disabled": false,
    "info": ""
  },
  {
    "id": "pilot-tls",
    "type": "tls-config",
    "name": "owned destination mTLS",
    "cert": "/pilot/tls/client.crt",
    "key": "/pilot/tls/client.key",
    "ca": "/pilot/ca.crt",
    "certType": "files",
    "servername": "wrong.invalid",
    "verifyservercert": true
  },
  {
    "id": "pilot-in",
    "type": "http in",
    "z": "pilot-tab",
    "name": "fixed trigger",
    "url": "/pilot",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "wires": [
      [
        "pilot-fixed"
      ]
    ]
  },
  {
    "id": "pilot-fixed",
    "type": "change",
    "z": "pilot-tab",
    "name": "constant request",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{\"probe\":true}",
        "tot": "json"
      },
      {
        "t": "delete",
        "p": "headers",
        "pt": "msg"
      },
      {
        "t": "delete",
        "p": "url",
        "pt": "msg"
      },
      {
        "t": "delete",
        "p": "method",
        "pt": "msg"
      },
      {
        "t": "delete",
        "p": "requestTimeout",
        "pt": "msg"
      },
      {
        "t": "set",
        "p": "followRedirects",
        "pt": "msg",
        "to": "false",
        "tot": "bool"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "wires": [
      [
        "pilot-request"
      ]
    ]
  },
  {
    "id": "pilot-request",
    "type": "http request",
    "z": "pilot-tab",
    "name": "fixed owned destination",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "${PILOT_TARGET}",
    "tls": "pilot-tls",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": true,
    "headers": [],
    "wires": [
      [
        "pilot-response"
      ]
    ]
  },
  {
    "id": "pilot-response",
    "type": "http response",
    "z": "pilot-tab",
    "name": "synthetic result",
    "statusCode": "",
    "headers": {},
    "wires": []
  },
  {
    "id": "pilot-catch",
    "type": "catch",
    "z": "pilot-tab",
    "name": "fail closed",
    "scope": [
      "pilot-request"
    ],
    "uncaught": false,
    "wires": [
      [
        "pilot-error"
      ]
    ]
  },
  {
    "id": "pilot-error",
    "type": "change",
    "z": "pilot-tab",
    "name": "static failure",
    "rules": [
      {
        "t": "set",
        "p": "statusCode",
        "pt": "msg",
        "to": "502",
        "tot": "num"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{\"error\":\"upstream_unavailable\"}",
        "tot": "json"
      },
      {
        "t": "delete",
        "p": "headers",
        "pt": "msg"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "wires": [
      [
        "pilot-response"
      ]
    ]
  }
]
